{
  "name": "pulsefit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-env.js",
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch-path=api --watch-path=server server/dev-api.js\" \"vite\"",
    "dev:memory": "concurrently -k -n api,web -c green,cyan \"node --watch-path=api --watch-path=server server/dev-api.js --memory\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "db:setup": "node scripts/db-setup.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "jose": "^6.2.12",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "express": "^4.22.3",
    "jsdom": "^29.1.1",
    "supertest": "^7.3.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
